# Copy to backend/.env and fill in. Never commit a filled copy.
# Every name here is required: settings.py reads each with no fallback
# default, so a missing one fails loudly at import rather than silently
# running on a value from source.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=

# `docker compose up -d` in backend/ serves these on non-default host ports:
# postgres://momus:momus@localhost:55432/momus and redis://localhost:56379/0
DATABASE_URL=
REDIS_URL=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
RESEND_API_KEY=
# WhatsApp (D-093): empty keys send nothing.
TERMII_API_KEY=
CALLMEBOT_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=

# Optional: each has a safe default, uncomment to override.
# FRONTEND_URL=http://localhost:3000
# CORS_EXTRA_ORIGINS=http://localhost:3001
# DEFAULT_FROM_EMAIL=no-reply@momuscollective.example
# Defaults to Resend when RESEND_API_KEY is set, else the console.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# BACKEND_URL=http://localhost:8000
# WHATSAPP_PROVIDER=  (termii or admin_bot; empty picks Termii if keyed)
# TERMII_SENDER_ID=
# TERMII_BASE_URL=https://api.ng.termii.com
# ADMIN_WHATSAPP_NUMBER=+234...
# Must be persistent storage in production (customer print files).
# DESIGN_FILES_ROOT=backend/private/design-files
# BACKUP_ROOT=backend/private/backups
# File storage (D-097): local or s3 (Cloudflare R2, S3, Backblaze) per purpose.
# FILE_STORAGE_PROVIDER=local
# BACKUP_STORAGE_PROVIDER=local
# With s3, these are required:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FILES_BUCKET=
# S3_BACKUP_BUCKET=
# Browser auth cookies (D-080). Secure works on http://localhost in Chrome
# and Firefox; set AUTH_COOKIE_SECURE=False to test over plain http in Safari.
# Production: frontend and API on one site, or AUTH_COOKIE_SAMESITE=None.
# AUTH_COOKIE_SECURE=True
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=
