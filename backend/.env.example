# Copy to backend/.env and fill in. Never commit a filled copy.
# Every name here is required: settings.py reads each with no fallback
# default, so a missing one fails loudly at import rather than silently
# running on a value from source.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=

# `docker compose up -d` in backend/ serves these on non-default host ports:
# postgres://momus:momus@localhost:55432/momus and redis://localhost:56379/0
DATABASE_URL=
REDIS_URL=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
RESEND_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=

# Optional: each has a safe default, uncomment to override.
# FRONTEND_URL=http://localhost:3000
# CORS_EXTRA_ORIGINS=http://localhost:3001
# DEFAULT_FROM_EMAIL=no-reply@momuscollective.example
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
